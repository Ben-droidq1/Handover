# Backend environment — copy to .env. `npm run dev` and `npm start` load it with
# node --env-file-if-exists, and real environment variables still win.

PORT=3001

# Leave empty in local dev to disable the owner gate.
# When set, POST/PATCH endpoints require the matching X-Owner-Password header.
OWNER_PASSWORD=

# Where SQLite, evidence packs, screenshots and raw Kane logs live.
DATA_DIR=data

# Kane CLI
# Binary override: path to kane-cli.cjs (recommended on Windows) or the binary itself.
KANE_BIN=
KANE_TIMEOUT_SEC=180
KANE_MAX_STEPS=20

# How many browsers run at once. Each Chrome instance uses ~150-300 MB.
MAX_CONCURRENCY=3

# Guard rail: refuse more criteria than this per project.
MAX_CRITERIA=8
